# NaijaFinSent web console configuration.
# Copy to `.env` (or `.env.local`) and adjust. All variables are build-time
# (Vite inlines anything prefixed with VITE_) — never put secrets in here.

# Base URL of the FastAPI service. Trailing slashes are normalised away.
VITE_API_BASE_URL=http://localhost:8000

# When "true", the client serves bundled SYNTHETIC fixtures instead of hitting
# the network. Use this to review the UI with the backend offline.
# Default is false (real API).
VITE_USE_MOCKS=false

# Per-request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Human-readable build label shown in the footer/health panel.
VITE_APP_ENV=development
