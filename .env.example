# NaijaFinSent environment template. Copy to .env and fill in.
# NEVER commit real secrets. The inference path must never depend on W&B.

# --- General ---
NFS_ENV=development
NFS_LOG_LEVEL=INFO

# --- Database (Postgres in prod, SQLite acceptable for local dev) ---
NFS_DATABASE_URL=sqlite:///./data/naijafinsent.db
# NFS_DATABASE_URL=postgresql+psycopg://naija:naija@localhost:5432/naijafinsent

# --- API ---
NFS_API_HOST=127.0.0.1
NFS_API_PORT=8000
NFS_CORS_ORIGINS=http://localhost:5173
NFS_RATE_LIMIT_PER_MINUTE=60
NFS_MAX_TEXT_CHARS=20000
NFS_MAX_BATCH_SIZE=32

# --- Ingestion ---
NFS_USER_AGENT=NaijaFinSent-ResearchBot/0.1 (+https://github.com/Culzz/NaijaFinSent)
NFS_FETCH_RATE_LIMIT_SECONDS=2.0
NFS_FETCH_MAX_BYTES=2000000
NFS_INGEST_CRON=0 */6 * * *

# --- Models ---
NFS_MODEL_REGISTRY_PATH=data/models/registry.json
NFS_SENTIMENT_MODEL=
NFS_NER_MODEL=
NFS_EVENT_MODEL=

# --- Optional: LLM baseline (few-shot Claude). Leave blank to disable. ---
ANTHROPIC_API_KEY=

# --- Optional: experiment tracking (never required for inference) ---
WANDB_PROJECT=
WANDB_API_KEY=
